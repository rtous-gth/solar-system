apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
  name: solar-system
  namespace: solar-system
spec:
    ingressClassName: nginx
    rules:
    - host: solar-system.local
      http:
        paths:
        - backend:
            service:
              name: solar-system
              port:
                number: 3000
          path: /
          pathType: Prefix
    tls:
    - hosts:
      - solar-system.localhost
      secretName: solar-local-tls
      
